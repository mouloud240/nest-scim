{
  "name": "@nest-scim/core",
  "version": "1.0.0",
  "description": "SCIM 2.0 (RFC 7643/7644) User provisioning server library for NestJS — the library owns the protocol (endpoints, PATCH, filtering, errors); you own only your data.",
  "homepage": "https://nest-scim.mouloud.foo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouloud240/nest-scim.git",
    "directory": "packages/scim"
  },
  "bugs": {
    "url": "https://github.com/mouloud240/nest-scim/issues"
  },
  "keywords": [
    "nestjs",
    "scim",
    "scim2",
    "provisioning",
    "saml",
    "sso",
    "okta",
    "entra-id"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.3.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "scim-patch": "^0.9.3",
    "scim2-parse-filter": "^0.3.0"
  }
}
