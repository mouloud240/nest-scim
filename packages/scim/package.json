{
  "name": "@nest-scim/core",
  "version": "0.0.0-alpha.0",
  "description": "SCIM 2.0 (RFC 7643/7644) User provisioning server library for NestJS — the library owns the protocol (endpoints, PATCH, filtering, errors); you own only your data.",
  "keywords": [
    "nestjs",
    "scim",
    "scim2",
    "provisioning",
    "saml",
    "sso",
    "okta",
    "entra-id"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "license": "UNLICENSED"
}
